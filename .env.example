TELEGRAM_TOKEN=123456789:AA...
TELEGRAM_CHAT_ID=987654321

# Optional: schuetzt die Oberflaeche mit HTTP-Basic-Auth. Der Schutz haengt
# allein an UI_PASSWORD; ist es leer, ist die Oberflaeche offen. UI_USER darf
# leer bleiben, dann ist der Benutzername im Anmeldefenster beliebig.
UI_USER=admin
UI_PASSWORD=
